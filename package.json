{
  "name": "lapvisor",
  "version": "0.1.0",
  "description": "CLI for race data analysis — lap times, GPS telemetry, sector splits, track tooling. Agent-friendly.",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "Ihar Nestsiarenia",
  "repository": {
    "type": "git",
    "url": "https://github.com/nesterione/lapvisor"
  },
  "bin": {
    "lapvisor": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "tsup",
    "test": "bun test",
    "lint": "biome check src",
    "format": "biome format --write src",
    "prepublishOnly": "bun run lint && bun test && bun run build"
  },
  "keywords": [
    "racing",
    "karting",
    "telemetry",
    "lap-times",
    "track-tools",
    "geojson",
    "cli",
    "ai",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "citty": "^0.1.6",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
