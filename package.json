{
  "name": "lapvisor",
  "version": "0.3.0",
  "description": "Race data toolkit (SDK + CLI) — lap times, GPS telemetry, sector splits, track tooling. Agent-friendly.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs/formats",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "Ihar Nestsiarenia",
  "repository": {
    "type": "git",
    "url": "https://github.com/nesterione/lapvisor"
  },
  "bin": {
    "lapvisor": "./dist/cli.js"
  },
  "exports": {
    "./model": {
      "types": "./dist/sdk/model.d.ts",
      "import": "./dist/sdk/model.js"
    },
    "./adapters": {
      "types": "./dist/sdk/adapters.d.ts",
      "import": "./dist/sdk/adapters.js"
    },
    "./analysis": {
      "types": "./dist/sdk/analysis.d.ts",
      "import": "./dist/sdk/analysis.js"
    },
    "./bundles": {
      "types": "./dist/sdk/bundles.d.ts",
      "import": "./dist/sdk/bundles.js"
    },
    "./track": {
      "types": "./dist/sdk/track.d.ts",
      "import": "./dist/sdk/track.js"
    },
    "./time": {
      "types": "./dist/sdk/time.d.ts",
      "import": "./dist/sdk/time.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "tsup",
    "test": "bun test",
    "lint": "biome check src",
    "format": "biome format --write src",
    "prepublishOnly": "bun run lint && bun test && bun run build"
  },
  "keywords": [
    "racing",
    "karting",
    "telemetry",
    "lap-times",
    "track-tools",
    "geojson",
    "sdk",
    "cli",
    "ai",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "citty": "^0.1.6",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
